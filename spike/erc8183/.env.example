# Get your personal RPC URL by running: arc-canteen status
# (Falls back to default Arc public testnet URL if not set; read-only works.)
ARC_RPC_URL=

# Required ONLY for `npm run full-lifecycle` (write flow):
# https://console.circle.com → Keys → "API key → Standard Key"
CIRCLE_API_KEY=
# Register at https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_ENTITY_SECRET=

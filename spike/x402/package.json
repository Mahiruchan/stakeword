{
  "name": "stakeword-x402-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "x402 HTTP 402 Payment Required dance between a local Express server and a viem-backed client. Proves StakeWord can charge USDC per AI coach call.",
  "scripts": {
    "server": "tsx --env-file-if-exists=.env src/server.ts",
    "client": "tsx --env-file-if-exists=.env src/client.ts",
    "mock-facilitator": "tsx --env-file-if-exists=.env src/mock-facilitator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/express": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "express": "^4.19.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
